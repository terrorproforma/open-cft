!modern/experiments/pic2d_cft_steady_state_v2/results-seed-b/
!modern/experiments/pic2d_cft_steady_state_v2/results-seed-b/maps.npz
!modern/experiments/pic2d_cft_steady_state_v2/results-seed-b/series.npz
