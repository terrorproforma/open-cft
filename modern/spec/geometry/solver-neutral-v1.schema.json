{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cft_revival.geometry.solver_neutral/1.1.0",
  "title": "Closed solver-neutral material geometry handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "coordinate_system",
    "config_id",
    "material_regions",
    "interfaces",
    "magnetization_sources",
    "external_components",
    "permanent_magnet_plan",
    "permanent_magnet_authority_rule"
  ],
  "properties": {
    "contract_version": {"const": "cft_revival.geometry.solver_neutral/1.1.0"},
    "coordinate_system": {"const": "right_handed_cylindrical_r_z_axisymmetric"},
    "config_id": {"$ref": "#/$defs/id"},
    "material_regions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/region"}
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/interface"}
    },
    "magnetization_sources": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/source"}
    },
    "external_components": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/external"}
    },
    "permanent_magnet_plan": {"$ref": "#/$defs/plan"},
    "permanent_magnet_authority_rule": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "not": {"pattern": "\\.\\."}
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r_inner_start_m",
        "r_inner_end_m",
        "r_outer_start_m",
        "r_outer_end_m",
        "z_min_m",
        "z_max_m"
      ],
      "properties": {
        "r_inner_start_m": {"const": "m"},
        "r_inner_end_m": {"const": "m"},
        "r_outer_start_m": {"const": "m"},
        "r_outer_end_m": {"const": "m"},
        "z_min_m": {"const": "m"},
        "z_max_m": {"const": "m"}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "owner_id",
        "role",
        "material_id",
        "shape",
        "r_inner_start_m",
        "r_inner_end_m",
        "r_outer_start_m",
        "r_outer_end_m",
        "z_min_m",
        "z_max_m",
        "polarity",
        "priority",
        "units"
      ],
      "properties": {
        "region_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "role": {"$ref": "#/$defs/id"},
        "material_id": {"$ref": "#/$defs/id"},
        "shape": {"enum": ["rectangular_annulus", "linear_taper_annulus"]},
        "r_inner_start_m": {"type": "number", "minimum": 0},
        "r_inner_end_m": {"type": "number", "minimum": 0},
        "r_outer_start_m": {"type": "number", "exclusiveMinimum": 0},
        "r_outer_end_m": {"type": "number", "exclusiveMinimum": 0},
        "z_min_m": {"type": "number"},
        "z_max_m": {"type": "number"},
        "polarity": {"oneOf": [{"enum": [-1, 1]}, {"type": "null"}]},
        "priority": {"type": "integer", "minimum": 0},
        "units": {"$ref": "#/$defs/units"}
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface_id",
        "region_id",
        "adjacent_region_id",
        "surface",
        "orientation",
        "start_rz_m",
        "end_rz_m",
        "unit_normal_rz",
        "free_surface_current_phi_a_per_m",
        "bound_current_semantics"
      ],
      "properties": {
        "interface_id": {"$ref": "#/$defs/id"},
        "region_id": {"$ref": "#/$defs/id"},
        "adjacent_region_id": {"$ref": "#/$defs/id"},
        "surface": {"enum": ["inner", "outer", "z_min", "z_max"]},
        "orientation": {
          "enum": [
            "outward_from_region_to_adjacent",
            "outward_from_region_to_ambient",
            "outward_to_symmetry_axis"
          ]
        },
        "start_rz_m": {"$ref": "#/$defs/point"},
        "end_rz_m": {"$ref": "#/$defs/point"},
        "unit_normal_rz": {"$ref": "#/$defs/vector"},
        "free_surface_current_phi_a_per_m": {"const": 0},
        "bound_current_semantics": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "region_id",
        "material_id",
        "direction_rz",
        "magnitude_semantics"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "region_id": {"$ref": "#/$defs/id"},
        "material_id": {"$ref": "#/$defs/id"},
        "direction_rz": {"$ref": "#/$defs/vector"},
        "magnitude_semantics": {"type": "string", "minLength": 1}
      }
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radial", "axial"],
      "properties": {
        "radial": {"type": "number"},
        "axial": {"type": "number"}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "authority", "solver_authoritative"],
      "properties": {
        "plan_id": {"$ref": "#/$defs/id"},
        "authority": {
          "enum": [
            "recoil_remanence_constitutive",
            "equivalent_bound_current"
          ]
        },
        "solver_authoritative": {"const": true}
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "kind",
        "axisymmetry",
        "location",
        "included_in_2d_model"
      ],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["cathode", "neutralizer"]},
        "axisymmetry": {"const": "external_non_axisymmetric_metadata"},
        "location": {"type": "string", "minLength": 1},
        "included_in_2d_model": {"const": false}
      }
    }
  }
}
