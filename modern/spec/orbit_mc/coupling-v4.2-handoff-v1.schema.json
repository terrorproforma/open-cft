{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cft-revival.local/spec/orbit-mc-coupling-v4.2-handoff-v1.schema.json",
  "title": "Orbit wall-loss handoff for coupling v4.2 and plasma_network",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classification", "quantity", "probability", "standard_uncertainty", "confidence_interval_95", "trial_count", "orbit_result_artifact_sha256", "result_identity_sha256", "batch_manifest_sha256", "verification_status", "estimator_policy", "coupling_target", "integration_status", "plasma_network_role"],
  "properties": {
    "schema_version": {"const": "cft-revival-orbit-mc-coupling-v4.2/1.3.0"},
    "classification": {"const": "test_particle_wall_loss_not_self_consistent_plasma"},
    "quantity": {"const": "electron_dielectric_wall_loss_probability"},
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "standard_uncertainty": {"type": "number", "minimum": 0},
    "confidence_interval_95": {
      "type": "array", "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ], "items": false, "minItems": 2, "maxItems": 2
    },
    "trial_count": {"type": "integer", "minimum": 1},
    "orbit_result_artifact_sha256": {"$ref": "#/$defs/hash"},
    "result_identity_sha256": {"$ref": "#/$defs/hash"},
    "batch_manifest_sha256": {"$ref": "#/$defs/hash"},
    "verification_status": {"const": "deterministic_replay_verified"},
    "estimator_policy": {"const": "unweighted_binomial"},
    "coupling_target": {"const": "cft-field-plasma-coupling/4.2.0"},
    "integration_status": {"const": "export_only_pending_consumer_integration"},
    "plasma_network_role": {"const": "export_only_pending_integration"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
