{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-cft.invalid/spec/experiment-runtime/manifest-v1.schema.json",
  "title": "open-cft fail-closed experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "state",
    "manifest_is_sole_completion_marker",
    "canonicalization",
    "lock_byte_sha256",
    "transition_log_sha256",
    "terminal_byte_sha256",
    "artifact_count",
    "required_directories",
    "root_identity",
    "durability",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "cft-revival.experiment-manifest/1.0.0"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "prebundle_failure",
        "runtime_failure",
        "development_rejection",
        "assessment_rejection",
        "accepted_result"
      ]
    },
    "manifest_is_sole_completion_marker": {
      "const": true
    },
    "canonicalization": {
      "const": "cft-typed-canonical-json-v1"
    },
    "lock_byte_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "transition_log_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "terminal_byte_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 1
    },
    "required_directories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "root_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "volume",
        "file_id",
        "final_path_sha256"
      ],
      "properties": {
        "platform": {
          "enum": [
            "windows-handle-v1",
            "posix-dirfd-v1"
          ]
        },
        "volume": {
          "type": "integer",
          "minimum": 0
        },
        "file_id": {
          "type": "integer",
          "minimum": 0
        },
        "final_path_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "durability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "temporary_open",
        "file_flush",
        "replace",
        "directory_metadata_flush",
        "power_loss_claim",
        "directory_flush_supported"
      ],
      "properties": {
        "platform": {
          "enum": [
            "windows",
            "posix"
          ]
        },
        "temporary_open": {
          "type": "string",
          "minLength": 1
        },
        "file_flush": {
          "type": "string",
          "minLength": 1
        },
        "replace": {
          "type": "string",
          "minLength": 1
        },
        "directory_metadata_flush": {
          "type": "string",
          "minLength": 1
        },
        "power_loss_claim": {
          "type": "string",
          "minLength": 1
        },
        "directory_flush_supported": {
          "type": "boolean"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "description": "Entries are unique and globally sorted lexically by path; runtime validation enforces this cross-item contract.",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "oneOf": [
        {
          "$ref": "#/$defs/fileArtifact"
        },
        {
          "$ref": "#/$defs/directoryArtifact"
        }
      ]
    },
    "directoryArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "contract"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "type": {
          "const": "directory"
        },
        "contract": {
          "const": "required-directory"
        }
      }
    },
    "fileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "bytes",
        "byte_sha256",
        "contract"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "type": {
          "const": "file"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "byte_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_json_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract": {
          "enum": [
            "immutable-lock",
            "approved-placeholder",
            "hash-sidecar",
            "hash-sidecar-metadata"
          ]
        },
        "sidecar": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
