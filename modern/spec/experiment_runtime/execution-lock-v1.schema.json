{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-cft.invalid/spec/experiment-runtime/execution-lock-v1.schema.json",
  "title": "open-cft immutable experiment execution lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "producer_id",
    "attempt",
    "commit",
    "command",
    "host",
    "device",
    "clean_worktree_attested",
    "acquired_at_utc",
    "immutable"
  ],
  "properties": {
    "schema_version": {
      "const": "cft-revival.experiment-execution-lock/1.0.0"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "producer_id": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|:))[^:\\\\]+:[A-Za-z_][A-Za-z0-9_.]*$",
      "maxLength": 4096
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "clean_worktree_attested": {
      "const": true
    },
    "acquired_at_utc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "__cft_type__",
        "value"
      ],
      "properties": {
        "__cft_type__": {
          "const": "aware-utc-datetime"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        }
      }
    },
    "immutable": {
      "const": true
    }
  }
}
