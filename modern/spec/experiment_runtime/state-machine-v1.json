{
  "schema_version": "cft-revival.experiment-runtime-state-machine/1.0.0",
  "initial_state": "unclaimed",
  "completion_marker": "manifest.json",
  "states": [
    "unclaimed",
    "lock_acquired",
    "cache_prepared",
    "prebundle_started",
    "prebundle_completed",
    "development_started",
    "development_accepted",
    "assessment_started",
    "prebundle_failure",
    "runtime_failure",
    "development_rejection",
    "assessment_rejection",
    "accepted_result"
  ],
  "terminal_bundle_states": [
    "prebundle_failure",
    "runtime_failure",
    "development_rejection",
    "assessment_rejection",
    "accepted_result"
  ],
  "rules": {
    "lock": "full-schema-validated O_EXCL, immutable, retained for every outcome",
    "phase_records": "atomic and committed before callback or expensive access",
    "artifact_pairs": "pinned-directory handle publication plus SHA-256 sidecar",
    "filesystem": "Windows handle identity/reparse checks or POSIX dirfd/openat no-follow",
    "inventory": "all files and required directories; links, special and empty unknown directories rejected",
    "cache": "bidirectional identity overlap rejection and pinned cleanup in outer finally",
    "completion": "private candidate validation then manifest-only final publication",
    "assessment": "unreachable after development rejection"
  },
  "transitions": [
    ["unclaimed", "lock_acquired"],
    ["lock_acquired", "cache_prepared"],
    ["lock_acquired", "prebundle_failure"],
    ["cache_prepared", "prebundle_started"],
    ["cache_prepared", "prebundle_failure"],
    ["prebundle_started", "prebundle_completed"],
    ["prebundle_started", "prebundle_failure"],
    ["prebundle_completed", "development_started"],
    ["development_started", "development_accepted"],
    ["development_started", "development_rejection"],
    ["development_started", "runtime_failure"],
    ["development_accepted", "assessment_started"],
    ["assessment_started", "assessment_rejection"],
    ["assessment_started", "accepted_result"],
    ["assessment_started", "runtime_failure"],
    ["accepted_result", "runtime_failure"],
    ["assessment_rejection", "runtime_failure"],
    ["development_rejection", "runtime_failure"]
  ],
  "event_transition_pairs": [
    ["lock-acquired", "cache-prepared"],
    ["lock-acquired", "prebundle-failed"],
    ["cache-prepared", "prebundle-started"],
    ["cache-prepared", "prebundle-failed"],
    ["prebundle-started", "prebundle-completed"],
    ["prebundle-started", "prebundle-failed"],
    ["prebundle-completed", "development-started"],
    ["development-started", "development-accepted"],
    ["development-started", "development-rejected"],
    ["development-started", "runtime-failed"],
    ["development-accepted", "assessment-started"],
    ["assessment-started", "assessment-accepted"],
    ["assessment-started", "assessment-rejected"],
    ["assessment-started", "runtime-failed"],
    ["assessment-accepted", "runtime-failed"],
    ["assessment-rejected", "runtime-failed"],
    ["development-rejected", "runtime-failed"],
    ["runtime-failed", "cleanup-failed"],
    ["prebundle-failed", "cleanup-failed"],
    ["prebundle-failed", "terminal"],
    ["runtime-failed", "terminal"],
    ["cleanup-failed", "terminal"],
    ["development-rejected", "terminal"],
    ["assessment-rejected", "terminal"],
    ["assessment-accepted", "terminal"]
  ]
}
