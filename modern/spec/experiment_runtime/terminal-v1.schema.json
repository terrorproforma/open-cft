{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-cft.invalid/spec/experiment-runtime/terminal-v1.schema.json",
  "title": "open-cft experiment terminal record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "payload",
    "primary_error",
    "secondary_errors",
    "counts"
  ],
  "properties": {
    "schema_version": {
      "const": "cft-revival.experiment-terminal/1.0.0"
    },
    "state": {
      "enum": [
        "prebundle_failure",
        "runtime_failure",
        "development_rejection",
        "assessment_rejection",
        "accepted_result"
      ]
    },
    "payload": {
      "type": "object"
    },
    "primary_error": {
      "oneOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "secondary_errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_count",
        "prebundle_access_count",
        "development_access_count",
        "assessment_access_count",
        "expensive_operation_count",
        "label_access_count"
      ],
      "properties": {
        "attempt_count": {
          "const": 1
        },
        "prebundle_access_count": {
          "$ref": "#/$defs/count"
        },
        "development_access_count": {
          "$ref": "#/$defs/count"
        },
        "assessment_access_count": {
          "$ref": "#/$defs/count"
        },
        "expensive_operation_count": {
          "$ref": "#/$defs/count"
        },
        "label_access_count": {
          "$ref": "#/$defs/count"
        }
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "message"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "maxLength": 65536
        }
      }
    }
  }
}
