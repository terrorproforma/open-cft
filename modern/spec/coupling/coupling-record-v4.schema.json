    "orbit_identity": {"anyOf": [{"$ref": "#/$defs/orbitIdentity"}, {"type": "null"}]},
    "held_out_validation": {"anyOf": [{"$ref": "#/$defs/heldOutValidation"}, {"type": "null"}]}
