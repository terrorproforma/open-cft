        "b_high_t": {"type": "number", "minimum": 0},
        "b_low_location_rz_m": {"$ref": "#/$defs/point"},
        "b_high_location_rz_m": {"$ref": "#/$defs/point"},
        "b_low_lower_t": {"type": "number", "minimum": 0},
        "b_high_upper_t": {"type": "number", "minimum": 0},
        "field_scale_length_m": {"$ref": "#/$defs/nullableFinite"},
        "interpolation_error_t": {"type": "number", "minimum": 0},
        "mirror_probability": {"$ref": "#/$defs/nullableFinite"},
        "probability_lower": {"$ref": "#/$defs/nullableFinite"},
        "probability_upper": {"$ref": "#/$defs/nullableFinite"},
        "path_hash": {"$ref": "#/$defs/hash"},
        "orbit_assessments": {"type": "array", "items": {"$ref": "#/$defs/orbitAssessment"}},
