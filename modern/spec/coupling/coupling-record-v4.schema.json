        "orbit_model_id": {"$ref": "#/$defs/nonempty"},
        "orbit_model_version": {"$ref": "#/$defs/nonempty"},
        "orbit_code_hash": {"$ref": "#/$defs/hash"},
        "orbit_config_hash": {"$ref": "#/$defs/hash"},
