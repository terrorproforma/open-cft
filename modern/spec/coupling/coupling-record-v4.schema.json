    "status": {"$ref": "#/$defs/status"},
    "reason": {"$ref": "#/$defs/nonempty"},
    "criterion": {"$ref": "#/$defs/criterion"},
    "geometry": {"$ref": "#/$defs/geometry"},
    "cusp_policy": {"$ref": "#/$defs/cuspPolicy"},
